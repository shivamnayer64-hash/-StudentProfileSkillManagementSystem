{
  "info": {
    "name": "Student Profile and Skill Development Management",
    "description": "Import and run these requests after starting the Spring Boot application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1 Add Student - Aarav",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": 101,\n  \"studentName\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"courseName\": \"CSE\",\n  \"programmingScore\": 88,\n  \"mathematicsScore\": 92,\n  \"technicalSkills\": [\n    \"Java\",\n    \"C++\",\n    \"SQL\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
